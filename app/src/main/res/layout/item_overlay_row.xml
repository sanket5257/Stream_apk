<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.StreamForge.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md"
    app:contentPadding="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivDragHandle"
                android:layout_width="28dp"
                android:layout_height="40dp"
                android:layout_marginEnd="@dimen/space_xs"
                android:contentDescription="Drag to reorder"
                android:scaleType="center"
                android:src="@drawable/ic_drag" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivOverlayIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_thumb_placeholder"
                android:contentDescription="@string/overlay_icon"
                android:padding="@dimen/space_sm"
                android:scaleType="centerCrop"
                app:shapeAppearance="@style/ShapeAppearance.SF.Small" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOverlayName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.SF.TitleMedium" />

                <TextView
                    android:id="@+id/tvOverlayDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:textAppearance="@style/TextAppearance.SF.Caption" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleVisibility"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/toggle_visibility"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_visibility"
                app:iconSize="20dp"
                app:iconTint="@color/action_green" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/delete_overlay"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_delete"
                app:iconSize="20dp"
                app:iconTint="@color/status_error" />

        </LinearLayout>

        <!-- Size controls -->
        <LinearLayout
            android:id="@+id/sizeControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_thumb_placeholder"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <!-- Width -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvWidthLabel"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:text="@string/overlay_width_label"
                    android:textAppearance="@style/TextAppearance.SF.Label" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWidthDown"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/overlay_width_decrease"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_remove"
                    app:iconSize="18dp"
                    app:iconTint="@color/text_primary" />

                <SeekBar
                    android:id="@+id/seekWidth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progressBackgroundTint="@color/divider"
                    android:progressTint="@color/action_green"
                    android:thumbTint="@color/action_green" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWidthUp"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/overlay_width_increase"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_add"
                    app:iconSize="18dp"
                    app:iconTint="@color/text_primary" />

            </LinearLayout>

            <!-- Height -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:text="@string/overlay_height_label"
                    android:textAppearance="@style/TextAppearance.SF.Label" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHeightDown"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/overlay_height_decrease"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_remove"
                    app:iconSize="18dp"
                    app:iconTint="@color/text_primary" />

                <SeekBar
                    android:id="@+id/seekHeight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progressBackgroundTint="@color/divider"
                    android:progressTint="@color/action_green"
                    android:thumbTint="@color/action_green" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHeightUp"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/overlay_height_increase"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_add"
                    app:iconSize="18dp"
                    app:iconTint="@color/text_primary" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top row: thumbnail, info, visibility, delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Thumbnail/Icon -->
            <ImageView
                android:id="@+id/ivOverlayIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerCrop"
                android:contentDescription="@string/overlay_icon" />

            <!-- Overlay Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvOverlayName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?android:textColorPrimary" />

                <TextView
                    android:id="@+id/tvOverlayDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="?android:textColorSecondary"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Bring forward (raise z-order) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMoveUp"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/overlay_move_up"
                app:icon="@android:drawable/arrow_up_float"
                app:iconTint="?attr/colorPrimary" />

            <!-- Send backward (lower z-order) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMoveDown"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/overlay_move_down"
                app:icon="@android:drawable/arrow_down_float"
                app:iconTint="?attr/colorPrimary" />

            <!-- Visibility Toggle -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleVisibility"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/toggle_visibility"
                app:icon="@android:drawable/ic_menu_view"
                app:iconTint="?attr/colorPrimary" />

            <!-- Delete Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/delete_overlay"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconTint="?attr/colorError" />
        </LinearLayout>

        <!-- Size controls: independent Width and Height rows -->
        <LinearLayout
            android:id="@+id/sizeControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp">

            <!-- Width row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="@string/overlay_width_label"
                    android:textSize="12sp"
                    android:textColor="?android:textColorSecondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWidthDown"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:contentDescription="@string/overlay_width_decrease"
                    app:icon="@android:drawable/ic_input_delete"
                    app:iconTint="?attr/colorPrimary" />

                <SeekBar
                    android:id="@+id/seekWidth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWidthUp"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:contentDescription="@string/overlay_width_increase"
                    app:icon="@android:drawable/ic_input_add"
                    app:iconTint="?attr/colorPrimary" />
            </LinearLayout>

            <!-- Height row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="@string/overlay_height_label"
                    android:textSize="12sp"
                    android:textColor="?android:textColorSecondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHeightDown"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:contentDescription="@string/overlay_height_decrease"
                    app:icon="@android:drawable/ic_input_delete"
                    app:iconTint="?attr/colorPrimary" />

                <SeekBar
                    android:id="@+id/seekHeight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHeightUp"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:contentDescription="@string/overlay_height_increase"
                    app:icon="@android:drawable/ic_input_add"
                    app:iconTint="?attr/colorPrimary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

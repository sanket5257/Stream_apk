<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface_elevated"
    app:cardElevation="4dp"
    app:cardCornerRadius="16dp"
    app:strokeWidth="1dp"
    app:strokeColor="#26FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top row: thumbnail, info, actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Thumbnail/Icon with Border -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/brand_primary">

                <ImageView
                    android:id="@+id/ivOverlayIcon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="8dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/overlay_icon" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Overlay Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/tvOverlayName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvOverlayDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <!-- Bring forward -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMoveUp"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/overlay_move_up"
                app:icon="@android:drawable/arrow_up_float"
                app:iconTint="@color/brand_primary"
                app:iconSize="20dp" />

            <!-- Send backward -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMoveDown"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/overlay_move_down"
                app:icon="@android:drawable/arrow_down_float"
                app:iconTint="@color/brand_primary"
                app:iconSize="20dp" />

            <!-- Visibility Toggle -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleVisibility"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/toggle_visibility"
                app:icon="@android:drawable/ic_menu_view"
                app:iconTint="@color/status_success"
                app:iconSize="22dp" />

            <!-- Delete Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/delete_overlay"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconTint="@color/status_error"
                app:iconSize="22dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Size controls: Width and Height -->
        <LinearLayout
            android:id="@+id/sizeControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_elevated"
            android:padding="12dp">

            <!-- Width row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvWidthLabel"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="@string/overlay_width_label"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWidthDown"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:contentDescription="@string/overlay_width_decrease"
                    app:icon="@android:drawable/ic_input_delete"
                    app:iconTint="@color/brand_primary"
                    app:iconSize="18dp" />

                <SeekBar
                    android:id="@+id/seekWidth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progressTint="@color/brand_primary"
                    android:thumbTint="@color/brand_primary"
                    android:progressBackgroundTint="@color/divider" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWidthUp"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:contentDescription="@string/overlay_width_increase"
                    app:icon="@android:drawable/ic_input_add"
                    app:iconTint="@color/brand_primary"
                    app:iconSize="18dp" />
            </LinearLayout>

            <!-- Height row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="@string/overlay_height_label"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHeightDown"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:contentDescription="@string/overlay_height_decrease"
                    app:icon="@android:drawable/ic_input_delete"
                    app:iconTint="@color/brand_primary"
                    app:iconSize="18dp" />

                <SeekBar
                    android:id="@+id/seekHeight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progressTint="@color/brand_primary"
                    android:thumbTint="@color/brand_primary"
                    android:progressBackgroundTint="@color/divider" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHeightUp"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:contentDescription="@string/overlay_height_increase"
                    app:icon="@android:drawable/ic_input_add"
                    app:iconTint="@color/brand_primary"
                    app:iconSize="18dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

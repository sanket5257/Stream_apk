<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:menu="@menu/menu_main"
            app:titleTextColor="@color/text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_2xl"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stream settings"
                android:textAppearance="@style/TextAppearance.SF.HeadlineLarge" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="Advanced connection and quality options"
                android:textAppearance="@style/TextAppearance.SF.BodyMedium" />

            <!-- Connection card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/streamSettingsCard"
                style="@style/Widget.StreamForge.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                app:contentPadding="@dimen/space_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_lg"
                        android:text="Connection"
                        android:textAppearance="@style/TextAppearance.SF.TitleMedium" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRtmpUrl"
                        style="@style/Widget.StreamForge.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/rtmp_url_label"
                        app:errorEnabled="true"
                        app:helperText="Your primary streaming server">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRtmpUrl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:singleLine="true" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilStreamKey"
                        style="@style/Widget.StreamForge.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:hint="@string/stream_key_label"
                        app:endIconMode="password_toggle"
                        app:errorEnabled="true"
                        app:helperText="Keep this private and secure">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etStreamKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:singleLine="true" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilBackupRtmpUrl"
                        style="@style/Widget.StreamForge.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:hint="@string/backup_rtmp_url_label"
                        app:errorEnabled="true"
                        app:helperText="Failover server (optional)">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBackupRtmpUrl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:singleLine="true" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Quality card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/qualitySettingsCard"
                style="@style/Widget.StreamForge.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                app:contentPadding="@dimen/space_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_lg"
                        android:text="Quality"
                        android:textAppearance="@style/TextAppearance.SF.TitleMedium" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilMicSource"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/mic_source_label">

                        <AutoCompleteTextView
                            android:id="@+id/actvMicSource"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilResolution"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:hint="@string/resolution_label">

                        <AutoCompleteTextView
                            android:id="@+id/actvResolution"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Video bitrate -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xl"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/video_bitrate_label"
                            android:textAppearance="@style/TextAppearance.SF.Label" />

                        <TextView
                            android:id="@+id/tvVideoBitrateValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="6000 kbps"
                            android:textColor="@color/action_green"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderVideoBitrate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="500"
                        android:value="6000"
                        android:valueFrom="1000"
                        android:valueTo="12000" />

                    <!-- Audio bitrate -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/audio_bitrate_label"
                            android:textAppearance="@style/TextAppearance.SF.Label" />

                        <TextView
                            android:id="@+id/tvAudioBitrateValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="128 kbps"
                            android:textColor="@color/action_green"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderAudioBitrate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="32"
                        android:value="128"
                        android:valueFrom="64"
                        android:valueTo="320" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Save & Go Live -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveAndGoLive"
                style="@style/Widget.StreamForge.Button.Live"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl"
                android:text="@string/save_and_go_live"
                android:textColor="@color/text_on_primary"
                app:cornerRadius="@dimen/radius_sm"
                app:icon="@drawable/ic_live_dot"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/space_sm"
                app:iconTint="@color/text_on_primary" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

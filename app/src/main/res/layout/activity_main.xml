<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- App Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configure your stream settings"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:layout_marginBottom="24dp" />

        <!-- RTMP URL Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRtmpUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/rtmp_url_label"
            android:layout_marginBottom="16dp"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRtmpUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Stream Key Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilStreamKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/stream_key_label"
            android:layout_marginBottom="16dp"
            app:errorEnabled="true"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etStreamKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Phase 7: Backup RTMP URL (optional) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBackupRtmpUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/backup_rtmp_url_label"
            android:layout_marginBottom="16dp"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBackupRtmpUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Phase 7: Microphone source -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMicSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/mic_source_label"
            android:layout_marginBottom="16dp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

            <AutoCompleteTextView
                android:id="@+id/actvMicSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:editable="false" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Resolution Dropdown -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilResolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/resolution_label"
            android:layout_marginBottom="16dp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

            <AutoCompleteTextView
                android:id="@+id/actvResolution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:editable="false" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Video Bitrate Slider -->
        <TextView
            android:id="@+id/tvVideoBitrateLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/video_bitrate_label"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:layout_marginTop="8dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderVideoBitrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="1000"
            android:valueTo="12000"
            android:stepSize="500"
            android:value="6000"
            android:layout_marginBottom="16dp" />

        <!-- Audio Bitrate Slider -->
        <TextView
            android:id="@+id/tvAudioBitrateLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/audio_bitrate_label"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:layout_marginTop="8dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderAudioBitrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="64"
            android:valueTo="320"
            android:stepSize="32"
            android:value="128"
            android:layout_marginBottom="24dp" />

        <!-- Save & Go Live Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveAndGoLive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_and_go_live"
            android:padding="16dp" />

    </LinearLayout>

</ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

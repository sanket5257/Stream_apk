<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_2xl">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_xl"
            android:text="@string/text_overlay_title"
            android:textAppearance="@style/TextAppearance.SF.TitleLarge" />

        <!-- Text content -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilText"
            style="@style/Widget.StreamForge.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/text_content_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text|textMultiLine"
                android:maxLines="3" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Size. Drives OverlayItem.scale (the SAME value as the overlay list's Size
             slider and preview pinch), so all three controls stay in sync. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/overlay_size_label"
                android:textAppearance="@style/TextAppearance.SF.Overline" />

            <TextView
                android:id="@+id/tvSizeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SF.Label"
                tools:text="1.0x" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSizeDown"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/overlay_size_decrease"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_remove"
                app:iconSize="18dp"
                app:iconTint="@color/text_primary" />

            <SeekBar
                android:id="@+id/seekSize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progressBackgroundTint="@color/divider"
                android:progressTint="@color/action_green"
                android:thumbTint="@color/action_green" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSizeUp"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/overlay_size_increase"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_add"
                app:iconSize="18dp"
                app:iconTint="@color/text_primary" />

        </LinearLayout>

        <!-- Font family -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/font_label"
            android:textAppearance="@style/TextAppearance.SF.Overline" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFont"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/font_label"
            app:startIconDrawable="@drawable/ic_text"
            app:startIconTint="@color/text_secondary">

            <AutoCompleteTextView
                android:id="@+id/actvFont"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Color -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_md"
            android:text="@string/color_label"
            android:textAppearance="@style/TextAppearance.SF.Overline" />

        <GridLayout
            android:id="@+id/colorGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            android:columnCount="6" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilHex"
            style="@style/Widget.StreamForge.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/custom_hex_color_hint"
            app:errorEnabled="true"
            app:startIconDrawable="@drawable/ic_palette"
            app:startIconTint="@color/text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etHex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="9"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Scrolling toggle -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/text_scroll_label"
            android:textAppearance="@style/TextAppearance.SF.Label" />

        <!-- Scroll track width. Only meaningful while scrolling is on, so the whole group
             hides with the switch. The track is centred on the overlay, so dragging the
             overlay in the preview moves the band it scrolls inside. -->
        <LinearLayout
            android:id="@+id/scrollAreaGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/text_scroll_area_label"
                    android:textAppearance="@style/TextAppearance.SF.Overline" />

                <TextView
                    android:id="@+id/tvScrollAreaValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.SF.Label"
                    tools:text="100%" />

            </LinearLayout>

            <SeekBar
                android:id="@+id/seekScrollArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progressBackgroundTint="@color/divider"
                android:progressTint="@color/action_green"
                android:thumbTint="@color/action_green" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/text_scroll_area_hint"
                android:textAppearance="@style/TextAppearance.SF.Caption" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>

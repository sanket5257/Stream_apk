<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_2xl">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_xl"
            android:text="@string/text_overlay_title"
            android:textAppearance="@style/TextAppearance.SF.TitleLarge" />

        <!-- Text content -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilText"
            style="@style/Widget.StreamForge.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/text_content_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text|textMultiLine"
                android:maxLines="3" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Font size -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/font_size_label"
                android:textAppearance="@style/TextAppearance.SF.Label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFontSize"
                style="@style/Widget.StreamForge.TextInput"
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                app:errorEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFontSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="3"
                    android:text="32"
                    android:textAlignment="center"
                    android:textColor="@color/action_green"
                    android:textStyle="bold" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderFontSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="2"
            android:value="32"
            android:valueFrom="12"
            android:valueTo="96" />

        <!-- Font family -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/font_label"
            android:textAppearance="@style/TextAppearance.SF.Overline" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFont"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/font_label"
            app:startIconDrawable="@drawable/ic_text"
            app:startIconTint="@color/text_secondary">

            <AutoCompleteTextView
                android:id="@+id/actvFont"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Color -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_md"
            android:text="@string/color_label"
            android:textAppearance="@style/TextAppearance.SF.Overline" />

        <GridLayout
            android:id="@+id/colorGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            android:columnCount="6" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilHex"
            style="@style/Widget.StreamForge.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/custom_hex_color_hint"
            app:errorEnabled="true"
            app:startIconDrawable="@drawable/ic_palette"
            app:startIconTint="@color/text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etHex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="9"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Scrolling toggle -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/text_scroll_label"
            android:textAppearance="@style/TextAppearance.SF.Label" />

    </LinearLayout>

</ScrollView>

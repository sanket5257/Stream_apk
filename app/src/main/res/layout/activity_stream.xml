<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Camera Preview -->
    <com.pedro.library.view.OpenGlView
        android:id="@+id/openGlView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <!-- Overlay Editor Surface -->
    <com.streamforge.app.ui.OverlayEditorView
        android:id="@+id/overlayEditor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <!-- Top Bar Container with Gradient Background -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_overlay_hud"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Audio Level Indicator -->
            <LinearLayout
                android:id="@+id/audioLevelContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_elevated"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvMicLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mic_level"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />

                <ProgressBar
                    android:id="@+id/audioLevelBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/status_success"
                    android:progressBackgroundTint="@color/divider" />

            </LinearLayout>

            <Space
                android:layout_width="16dp"
                android:layout_height="1dp" />

            <!-- Stream Status Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_elevated"
                android:padding="12dp"
                android:gravity="end">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivStatusDot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_live_dot"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvStreamStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/status_idle"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

                <!-- Stats HUD -->
                <TextView
                    android:id="@+id/tvStatsHud"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Control Panel with Modern Design -->
    <LinearLayout
        android:id="@+id/bottomControlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_overlay_hud"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Main Control Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <!-- Overlay Management Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageOverlays"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:text="@string/overlays"
                android:textSize="14sp"
                app:backgroundTint="@color/surface_elevated"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_menu_gallery"
                app:iconTint="@color/brand_primary" />

            <!-- Mute Toggle Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMuteToggle"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:text="@string/mute"
                android:textSize="14sp"
                app:backgroundTint="@color/surface_elevated"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_btn_speak_now"
                app:iconTint="@color/brand_primary" />

            <!-- Switch Camera Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSwitchCamera"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:text="@string/switch_camera"
                android:textSize="14sp"
                app:backgroundTint="@color/surface_elevated"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_menu_camera" />

            <!-- Rotate Screen Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRotateScreen"
                style="@style/Widget.Material3.Button.TonalButton.Icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/rotate_screen"
                app:backgroundTint="@color/surface_elevated"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_menu_rotate"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="@color/brand_primary" />

        </LinearLayout>

        <!-- Go Live / Stop Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoLive"
            style="@style/Widget.StreamForge.Button.Live"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_button_live"
            android:text="@string/go_live"
            android:textSize="20sp"
            app:backgroundTint="@null"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_live_dot"
            app:iconGravity="textStart"
            app:iconSize="28dp"
            app:iconPadding="12dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

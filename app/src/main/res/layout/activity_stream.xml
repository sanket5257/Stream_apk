<?xml version="1.0" encoding="utf-8"?>
<!--
    Studio screen.

    Four views, in a deliberate order:
      1. OpenGlView        — RootEncoder's GL surface. This IS the encoder's video feed, so it
                             must stay a native SurfaceView; it cannot be reimplemented in
                             Compose.
      2. OverlayEditorView — the multi-touch drag / pinch / rotate surface for overlays.
      3. studioTop / studioBottom — the Compose chrome.

    The chrome is deliberately TWO wrap_content ComposeViews pinned to the top and bottom
    rather than one full-screen view. A ComposeView consumes the touch events it receives, so
    a full-screen one would swallow every drag meant for the overlay editor underneath. Split
    this way, the middle of the frame — where overlays are actually positioned — stays free.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.pedro.library.view.OpenGlView
        android:id="@+id/openGlView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <com.streamforge.app.ui.OverlayEditorView
        android:id="@+id/overlayEditor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/studioTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/studioBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ==================================================================
         StreamForge Design System - COLOR TOKENS (Light / default)
         Clean Material 3 surfaces, YouTube-red brand. Dark overrides live in
         values-night/colors.xml. Every name used by existing layouts is kept.
         ================================================================== -->

    <!-- Brand: YouTube red -->
    <color name="brand_primary">#FF0000</color>
    <color name="brand_primary_dark">#CC0000</color>
    <color name="brand_primary_light">#FF5252</color>
    <color name="brand_primary_container">#FFE0E0</color>
    <color name="on_brand_primary_container">#410002</color>

    <!-- Secondary accent: YouTube link blue -->
    <color name="brand_secondary">#065FD4</color>
    <color name="brand_secondary_dark">#0546A0</color>
    <color name="brand_accent">#FF4081</color>

    <!-- Surfaces and background (light) -->
    <color name="surface_dark">#F6F7F9</color>
    <color name="surface_card">#FFFFFF</color>
    <color name="surface_elevated">#F0F2F5</color>
    <color name="surface_variant">#ECEEF1</color>
    <color name="background_gradient_start">#FFFFFF</color>
    <color name="background_gradient_end">#F0F2F8</color>

    <!-- Text -->
    <color name="text_primary">#0F0F0F</color>
    <color name="text_secondary">#5F6368</color>
    <color name="text_tertiary">#909499</color>
    <color name="text_on_primary">#FFFFFF</color>

    <!-- Lines and dividers -->
    <color name="divider">#E3E5E8</color>
    <color name="outline">#D0D3D8</color>

    <!-- Primary ACTION color (reference "Enter Studio" green) -->
    <color name="action_green">#16B36A</color>
    <color name="action_green_dark">#0E8E53</color>
    <color name="on_action">#FFFFFF</color>
    <color name="action_green_container">#D6F5E6</color>
    <color name="on_action_container">#06371F</color>

    <!-- Status / semantic -->
    <color name="status_live">#FF0000</color>
    <color name="status_success">#16B36A</color>
    <color name="status_success_container">#D6F5E6</color>
    <color name="status_warning">#E8A100</color>
    <color name="status_error">#E84B5A</color>
    <color name="status_scheduled">#065FD4</color>

    <!-- Action-tile accents (match reference Home tiles) -->
    <color name="tile_live_fg">#E84B8A</color>
    <color name="tile_live_bg">#FCE4EF</color>
    <color name="tile_rec_fg">#FF4D5E</color>
    <color name="tile_rec_bg">#FFE3E6</color>
    <color name="tile_schedule_fg">#14A8A8</color>
    <color name="tile_schedule_bg">#DCF3F3</color>

    <!-- Brand logo gradient (pink -> purple -> blue diamond) -->
    <color name="logo_grad_start">#FF3D7F</color>
    <color name="logo_grad_mid">#7C4DFF</color>
    <color name="logo_grad_end">#2D9CFF</color>

    <!-- Overlays / scrims (sit on camera preview, stay dark) -->
    <color name="overlay_dark">#CC000000</color>
    <color name="overlay_medium">#80000000</color>
    <color name="overlay_light">#40000000</color>
    <color name="scrim">#99000000</color>

    <!-- Interactive -->
    <color name="button_primary">#FF0000</color>
    <color name="button_secondary">#065FD4</color>
    <color name="ripple_color">#1F000000</color>

    <!-- Launcher -->
    <color name="ic_launcher_background">#FF0000</color>
</resources>
